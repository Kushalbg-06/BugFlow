DATABASE_URL=sqlite:///./bugflow.db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60


AI_PROVIDER=model_you_are_using[ex:gemini,openai,anthropic etc..]

#any one of them

ANTHROPIC_API_KEY=your_antropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Check https://ai.google.dev/gemini-api/docs/models for the current model
# name — Gemini model names change more often than the other two providers.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash